<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <!-- Hosts with IIS WebDAV installed (Plesk production) grab PUT/DELETE and answer 405 before they reach
           ASP.NET Core - editing a card (PUT api/Box/{id}/flashcard) failed there. Removing the WebDAV handler is
           harmless where it isn't installed. NOT <modules><remove name="WebDAVModule"/>: that section is locked on
           the local IIS stage (500.19) - if production still answers 405, remove the module on the server itself. -->
      <handlers>
        <remove name="WebDAV" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <aspNetCore processPath="dotnet" arguments=".\MyLeitner.Api.dll" stdoutLogEnabled="false" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
